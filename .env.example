# Contact form — configure ONE provider (Formspree is checked first).
# Leave all empty to fall back to opening a pre-filled email draft.

# Formspree: create a form at https://formspree.io and paste its endpoint.
VITE_FORMSPREE_ENDPOINT=

# EmailJS: https://dashboard.emailjs.com (Email Services, Email Templates, Account > Public Key).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: absolute site URL for canonical / Open Graph tags, e.g. https://example.com
VITE_SITE_URL=
